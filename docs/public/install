#!/bin/sh
# Installs the latest Pun release, or the one you name:
#
#   curl -fsSL https://pun.laravel.cloud/install | sh
#   curl -fsSL https://pun.laravel.cloud/install | sh -s -- v0.1.0
#
# The docs site serves this file from docs/public/install. Everything runs inside main(), called on the last line:
# a download cut short defines a partial function or none, and runs nothing.
#
# Environment:
#   PUN_INSTALL              install root; the binary goes in $PUN_INSTALL/bin (default: ~/.pun)
#   PUN_REQUIRE_ATTESTATION  1 to fail unless the GitHub build attestation verifies (needs a signed-in gh)

set -eu

PUN_REPO='punphp/pun'

say() {
    printf 'pun-installer: %s\n' "$1" >&2
}

fail() {
    say "error: $1"
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

detect_target() {
    os=$(uname -s)
    arch=$(uname -m)
    case "$arch" in
        x86_64 | amd64) arch=x86_64 ;;
        arm64 | aarch64) arch=aarch64 ;;
        *) fail "unsupported CPU architecture $arch (Pun ships x86_64 and aarch64 binaries)" ;;
    esac
    case "$os" in
        Darwin)
            # A shell running under Rosetta reports x86_64 on Apple silicon; install the native binary.
            if [ "$arch" = x86_64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || true)" = 1 ]; then
                arch=aarch64
            fi
            echo "$arch-apple-darwin"
            ;;
        # Static musl binaries, so one build runs on glibc and Alpine alike.
        Linux) echo "$arch-unknown-linux-musl" ;;
        *) fail "unsupported OS $os (Pun ships Linux and macOS binaries)" ;;
    esac
}

# HTTPS only, TLS 1.2 or newer, for the first request and every redirect, and an HTTP error is a failure.
# Prints nothing and returns 1 on failure, so callers choose the message.
fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error --retry 3 --output "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget --https-only --secure-protocol=TLSv1_2 --quiet --output-document="$2" "$1"
    else
        fail "curl or wget is required"
    fi
}

download() {
    fetch "$1" "$2" || fail "download failed: $1"
}

# The latest stable release; until there is one, the newest pre-release. GitHub's releases/latest skips pre-releases,
# so this asks the API, and falls back to the releases feed when the API's rate limit is used up.
latest_tag() {
    api="https://api.github.com/repos/$PUN_REPO/releases"
    if fetch "$api/latest" "$work/release" 2>/dev/null || fetch "$api?per_page=1" "$work/release" 2>/dev/null; then
        sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' "$work/release" | head -n 1
    elif fetch "https://github.com/$PUN_REPO/releases.atom" "$work/release" 2>/dev/null; then
        sed -n 's|.*/releases/tag/\([^"<]*\).*|\1|p' "$work/release" | head -n 1
    fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d ' ' -f 1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d ' ' -f 1
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 -r "$1" | cut -d ' ' -f 1
    else
        fail "sha256sum, shasum or openssl is required to verify the download"
    fi
}

# GitHub's build attestation proves the archive came from Pun's release workflow, run on a GitHub-hosted runner for
# that tag, which the checksum alone cannot: the checksum comes from the same release as the archive. It needs gh
# signed in, so without one it is skipped unless PUN_REQUIRE_ATTESTATION=1.
verify_attestation() {
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
        gh attestation verify "$1" --repo "$PUN_REPO" \
            --signer-workflow "github.com/$PUN_REPO/.github/workflows/release.yml" \
            --source-ref "refs/tags/$tag" --deny-self-hosted-runners >/dev/null ||
            fail "the build attestation of $2 does not verify; the download may have been tampered with"
        say "verified the GitHub build attestation"
    elif [ "${PUN_REQUIRE_ATTESTATION:-0}" = 1 ]; then
        fail "PUN_REQUIRE_ATTESTATION=1 needs the GitHub CLI (gh), signed in"
    else
        say "skipped the build attestation (needs a signed-in gh)"
    fi
}

main() {
    [ $# -le 1 ] || fail "usage: sh install [version]"
    need uname
    need tar
    need mktemp
    need sed

    target=$(detect_target)
    root=${PUN_INSTALL:-}
    if [ -z "$root" ]; then
        [ -n "${HOME:-}" ] || fail "HOME is not set; set PUN_INSTALL"
        root="$HOME/.pun"
    fi
    bin="$root/bin"

    work=$(mktemp -d) || fail "could not create a temporary directory"
    trap 'rm -rf "$work"' EXIT
    trap 'exit 1' HUP INT TERM

    if [ $# -eq 1 ]; then
        tag="v${1#v}"
    else
        tag=$(latest_tag)
        [ -n "$tag" ] || fail "could not find the latest release; name one: sh -s -- v0.1.0"
    fi
    # The tag goes into URLs and a version check, so it must be a plain release version.
    case "$tag" in
        v[0-9]*.[0-9]*.[0-9]*) ;;
        *) fail "not a release version: $tag" ;;
    esac
    case "${tag#v}" in
        *[!0-9A-Za-z.-]*) fail "not a release version: $tag" ;;
    esac
    version=${tag#v}

    archive="punphp-$target.tar.gz"
    url="https://github.com/$PUN_REPO/releases/download/$tag/$archive"
    say "downloading Pun $version for $target"
    download "$url" "$work/$archive"
    download "$url.sha256" "$work/$archive.sha256"

    expected=$(cut -d ' ' -f 1 "$work/$archive.sha256")
    actual=$(sha256_of "$work/$archive")
    if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
        fail "checksum mismatch for $archive (expected $expected, got $actual); the download may be corrupt"
    fi
    say "verified the SHA-256 checksum"
    verify_attestation "$work/$archive" "$archive"

    # Only regular files and directories under punphp-<target>/: no links, devices, absolute paths or "..".
    tar -tvzf "$work/$archive" >"$work/listing" || fail "$archive is not a gzip tar archive"
    while IFS= read -r line; do
        case "$line" in
            -* | d*) ;;
            *) fail "$archive holds an entry that is not a file or directory: $line" ;;
        esac
    done <"$work/listing"
    tar -tzf "$work/$archive" >"$work/names"
    while IFS= read -r name; do
        case "$name" in
            "punphp-$target/" | "punphp-$target/"[!/]*) ;;
            *) fail "$archive holds an unexpected path: $name" ;;
        esac
        case "/$name/" in
            */../* | */./*) fail "$archive holds an unexpected path: $name" ;;
        esac
    done <"$work/names"
    mkdir "$work/x"
    tar -xzf "$work/$archive" -C "$work/x" || fail "could not extract $archive"
    new="$work/x/punphp-$target/pun"
    if [ ! -f "$new" ] || [ -L "$new" ]; then
        fail "$archive holds no pun binary"
    fi
    chmod 755 "$new"

    reported=$("$new" --version 2>/dev/null) || fail "the downloaded pun does not run on this machine"
    [ "$reported" = "pun $version" ] || fail "the downloaded pun reports '$reported', not 'pun $version'"

    mkdir -p "$bin" || fail "could not create $bin"
    # Copied next to the destination first, so the final rename stays on one filesystem: a running `pun` or a
    # second install never sees half a file.
    cp "$new" "$bin/.pun.$$" || fail "could not write to $bin"
    mv -f "$bin/.pun.$$" "$bin/pun" || fail "could not write $bin/pun"
    say "installed pun $version to $bin/pun"

    case ":${PATH:-}:" in
        *":$bin:"*) ;;
        *)
            say "$bin is not on your PATH. Add it with:"
            # shellcheck disable=SC2016 # $PATH is printed for the user's shell to expand
            case "$(basename "${SHELL:-sh}")" in
                fish) printf '\n  fish_add_path %s\n\n' "$bin" >&2 ;;
                zsh) printf '\n  echo '\''export PATH="%s:$PATH"'\'' >> ~/.zshrc\n\n' "$bin" >&2 ;;
                bash) printf '\n  echo '\''export PATH="%s:$PATH"'\'' >> ~/.bashrc\n\n' "$bin" >&2 ;;
                *) printf '\n  export PATH="%s:$PATH"\n\n' "$bin" >&2 ;;
            esac
            ;;
    esac
}

main "$@"
