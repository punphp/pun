---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Home from "./_home/Home.astro";

// The homepage. Everything else on the site is Markdown under content/.
const { config } = data;
const pageTitle = "Pun: PHP tooling, zero waiting";
const pageDescription =
  "One fast Rust binary for format, lint, analyse and migrate. Same results as Pint, Rector and PHPStan, 167× faster than Pint on laravel/framework.";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
>
  <Home />
</PageLayout>
