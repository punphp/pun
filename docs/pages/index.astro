---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Home from "./_home/Home.astro";

// The homepage. Everything else on the site is Markdown under content/.
const { config } = data;
const pageTitle = "Pun: the ultrafast unified PHP toolchain";
const pageDescription =
  "A very, very fast all-in-one PHP toolchain in one Rust binary: format, lint, analyse and migrate today, Composer-compatible package installs next.";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  ogImage="/og.png"
  ogImageAlt="Pun: ultrafast unified PHP tooling."
  ogImageSize={{ width: 1200, height: 630 }}
  page={{ description: pageDescription, route: "/", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
>
  <Home />
</PageLayout>
