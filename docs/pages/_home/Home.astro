---
// Pun homepage, Sticker Pop. Colors, shadows and strokes come from the --pun-* tokens in ../../theme.css.
const installs = [
  { label: "composer", command: "composer require --dev punphp/pun" },
  { label: "curl", command: "curl -LsSf https://github.com/punphp/pun/releases/latest/download/punphp-installer.sh | sh" },
  { label: "brew", command: "brew install punphp/tap/pun" },
  { label: "npm", command: "npm install --save-dev @punphp/pun" },
];

const ribbon = ["one binary", "reads pint.json", "byte-for-byte", "built in Rust", "one pun.toml", "no levels", "no PHP to check"];

const tools = [
  { letter: "F", tone: "zap", title: "Format", replaces: "Pint · PHP-CS-Fixer", text: "Pint-identical bytes, 51× faster.", command: "pun format", status: "ready", statusTone: "mint", href: "/docs/commands/format" },
  { letter: "A", tone: "lilac", title: "Analyse", replaces: "PHPStan · Larastan", text: "Type errors, no levels to juggle.", command: "pun analyse", status: "building", statusTone: "zap", href: "/docs/roadmap" },
  { letter: "L", tone: "gum", title: "Lint", replaces: "Rector · Mago", text: "Code rules with autofix, one config.", command: "pun lint --fix", status: "designed", statusTone: "lilac", href: "/docs/commands/lint" },
  { letter: "E", tone: "mint", title: "Editor", replaces: "format-on-save plugins", text: "One LSP for VS Code, Neovim and PhpStorm.", command: "pun lsp", status: "ready", statusTone: "mint", href: "/docs/commands/lsp" },
];

const lanes = [
  { who: "Pint", sub: "PHP", seconds: 190, tone: "slow" },
  { who: "pun", sub: "cold", seconds: 3.7, tone: "zap" },
  { who: "pun", sub: "warm cache", seconds: 0.07, tone: "gum" },
];
const max = 190;

const diff = ["@@ -1,3 +1,3 @@", " <?php", "-$a = array( 1 );", "+$a = [1];"];
const lineClass = (l: string) => (l.startsWith("@@") ? "dim" : l.startsWith("+") ? "add" : l.startsWith("-") ? "del" : "");
---

<div class="pun-home">
  <section class="hero wrap">
    <div class="hero-copy">
      <span class="pill"><span class="tag mint">pre-release</span>pun format is Pint-identical</span>
      <h1>PHP tooling, <span class="sticker">zero</span> waiting.</h1>
      <p class="lede">One Rust binary for format, lint and analyse. Reads your pint.json, gives the same bytes back, 51× sooner.</p>

      <div class="install" data-install>
        <div class="tabs" role="tablist" aria-label="Install with">
          {installs.map((o, i) => (
            <button class="tab" role="tab" type="button" aria-selected={i === 0 ? "true" : "false"} data-command={o.command}>{o.label}</button>
          ))}
        </div>
        <div class="cmd">
          <code><span class="prompt" aria-hidden="true">$</span><span data-command-text>{installs[0].command}</span></code>
          <button class="copy" type="button" data-copy>copy</button>
        </div>
      </div>

      <div class="actions">
        <a class="btn zap" href="/docs/quickstart">Get started <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href="/docs">Read the docs</a>
      </div>
    </div>

    <div class="stage">
      <div class="panel">
        <div class="ring" aria-hidden="true"></div>
        <img src="/mascot.webp" width="900" height="900" alt="The Pun mascot: a grape elephant in yellow sneakers, sprinting and winking" />
      </div>
      <div class="burst" aria-hidden="true">51×<small>vs Pint</small></div>
      <div class="loose" aria-hidden="true">$ pun format</div>
    </div>
  </section>

  <div class="ribbon" aria-label={ribbon.join(", ")}>
    <div class="ribbon-track" aria-hidden="true">
      {[...ribbon, ...ribbon].map((t) => <span>{t}</span>)}
    </div>
  </div>

  <section class="wrap sec">
    <p class="kicker">one install</p>
    <h2>Four tools. <span class="sticker gum">One</span> binary.</h2>
    <div class="tools">
      {tools.map((t, i) => (
        <a class="tool" href={t.href} style={`--tilt:${i % 2 ? 1 : -1}deg`}>
          <span class={`tag ${t.statusTone}`}>{t.status}</span>
          <span class={`tile ${t.tone}`} aria-hidden="true">{t.letter}</span>
          <h3>{t.title}</h3>
          <span class="replaces">replaces {t.replaces}</span>
          <p>{t.text}</p>
          <code>$ {t.command}</code>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap sec race">
    <div>
      <p class="kicker">laravel/framework, formatted</p>
      <h2>Blink and<br />it's done.</h2>
      <div class="mega">51<sup>×</sup></div>
    </div>
    <figure class="bench" aria-label="Pint 190 seconds, pun 3.7 seconds cold, pun 0.07 seconds warm">
      <div class="bench-title"><span>pun format vs pinned Pint</span><span>lower is better</span></div>
      {lanes.map((l) => {
        const pct = l.seconds / max;
        const long = pct > 0.6;
        return (
          <div class="lane">
            <div class="who">{l.who}<small>{l.sub}</small></div>
            <div class="bar">
              <div class={`fill ${l.tone}`} style={long ? "width:100%" : `width:calc((100% - 80px) * ${pct.toFixed(4)} + 40px)`}></div>
              <span class={long ? "val in" : "val"}>{l.seconds} s</span>
            </div>
          </div>
        );
      })}
      <figcaption><span>laravel/framework, whole repo</span><a href="/docs/parity">how it's measured →</a></figcaption>
    </figure>
  </section>

  <section class="wrap sec">
    <p class="kicker">parity, not "close enough"</p>
    <h2>Same bytes as Pint.</h2>
    <div class="parity">
      <div class="code">
        <div class="code-bar"><span>pint --test</span><span>PHP</span></div>
        <pre>{diff.map((l) => <span class={lineClass(l)}>{l}{"\n"}</span>)}</pre>
      </div>
      <div class="eq" aria-label="identical">=<small>identical</small></div>
      <div class="code">
        <div class="code-bar"><span>pun format --test</span><span>Rust</span></div>
        <pre>{diff.map((l) => <span class={lineClass(l)}>{l}{"\n"}</span>)}</pre>
      </div>
    </div>
    <div class="score">
      <div><b>6</b><span>real projects</span></div>
      <div><b>7,202</b><span>files compared</span></div>
      <div><b>0</b><span>files differing</span></div>
      <a class="btn sm" href="/docs/parity">See the scoreboard</a>
    </div>
  </section>

  <section class="wrap">
    <div class="cta">
      <h2>Stop waiting<br />on your tools.</h2>
      <div class="actions">
        <a class="btn zap" href="/docs/quickstart">Get started <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href="https://github.com/punphp/pun">Star on GitHub</a>
      </div>
    </div>
  </section>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-install]")) {
    const text = box.querySelector<HTMLElement>("[data-command-text]");
    const copy = box.querySelector<HTMLButtonElement>("[data-copy]");
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        for (const t of tabs) t.setAttribute("aria-selected", t === tab ? "true" : "false");
        if (text) text.textContent = tab.dataset.command ?? "";
      });
    }
    copy?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(text?.textContent ?? "");
        copy.textContent = "copied";
        setTimeout(() => (copy.textContent = "copy"), 1200);
      } catch {}
    });
  }
</script>

<style>
  .pun-home { color: var(--pun-ink); overflow-x: clip; font-family: var(--blume-font-body); }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  h1, h2, h3 { font-family: var(--blume-font-display); color: var(--pun-ink); margin: 0; }
  h2 { font-size: clamp(40px, 5.6vw, 64px); line-height: .95; font-weight: 800; letter-spacing: -.04em; margin-bottom: 40px; }
  .kicker { font: 600 12px/1 var(--blume-font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--pun-ink-3); margin: 0 0 12px; }
  .sec { padding-top: 96px; }
  a { color: inherit; }
  :where(a, button):focus-visible { outline: 3px solid var(--blume-accent); outline-offset: 3px; }

  /* stickers */
  .sticker { display: inline-block; padding: 0 .12em; background: var(--pun-zap); color: var(--pun-on-fill); border: var(--pun-stroke) solid var(--pun-outline); border-radius: 10px; box-shadow: var(--pun-pop-sm); transform: rotate(-2deg); }
  .sticker.gum { background: var(--pun-gum); }
  .tag { display: inline-flex; padding: 5px 9px; border: var(--pun-stroke-thin) solid var(--pun-outline); border-radius: 999px; background: var(--pun-card); color: var(--pun-ink); font: 700 10.5px/1 var(--blume-font-mono); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .tag.mint { background: var(--pun-mint); color: var(--pun-on-fill); }
  .tag.zap { background: var(--pun-zap); color: var(--pun-on-fill); }
  .tag.lilac { background: var(--pun-lilac); color: var(--pun-on-fill); }
  .pill { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px 6px 6px; border: var(--pun-stroke-thin) solid var(--pun-outline); border-radius: 999px; background: var(--pun-card); box-shadow: var(--pun-pop-sm); font: 500 12px/1 var(--blume-font-mono); }

  .btn { display: inline-flex; align-items: center; gap: 10px; padding: 13px 20px; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 999px; background: var(--pun-card); color: var(--pun-ink); font: 700 15px/1 var(--blume-font-display); text-decoration: none; box-shadow: var(--pun-pop); transition: transform .12s ease, box-shadow .12s ease; }
  .btn:hover { transform: translate(-2px, -2px); box-shadow: var(--pun-pop-hover); }
  .btn:active { transform: translate(3px, 3px); box-shadow: var(--pun-pop-press); }
  .btn.zap { background: var(--pun-zap); color: var(--pun-on-fill); }
  .btn.sm { padding: 9px 14px; font-size: 14px; box-shadow: var(--pun-pop-sm); }
  .btn .arrow { transition: transform .12s ease; }
  .btn:hover .arrow { transform: translateX(3px); }
  .actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 28px; }

  /* hero */
  .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; padding-top: 48px; padding-bottom: 96px; }
  .hero h1 { font-size: clamp(52px, 7.4vw, 88px); line-height: .92; font-weight: 800; letter-spacing: -.045em; margin: 24px 0 20px; }
  .lede { font-size: 20px; line-height: 1.45; color: var(--pun-ink-2); max-width: 32ch; margin: 0 0 30px; }
  .install { max-width: 540px; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 16px; background: var(--pun-code-bg); color: var(--pun-code-ink); box-shadow: var(--pun-pop-lilac); overflow: hidden; }
  .tabs { display: flex; gap: 2px; padding: 6px 6px 0; background: var(--pun-code-bar); }
  .tab { font: 500 12px/1 var(--blume-font-mono); padding: 9px 12px; border: 0; border-radius: 8px 8px 0 0; background: transparent; color: var(--pun-code-ink); opacity: .7; cursor: pointer; }
  .tab[aria-selected="true"] { background: var(--pun-code-bg); color: var(--pun-zap); opacity: 1; }
  .cmd { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; font: 500 14px/1.45 var(--blume-font-mono); }
  .cmd code { overflow-x: auto; white-space: nowrap; font: inherit; color: inherit; background: none; }
  .prompt { color: var(--pun-gum); margin-right: 10px; user-select: none; }
  .copy { flex: none; font: 700 11px/1 var(--blume-font-mono); padding: 8px 10px; border: 0; border-radius: 10px; background: var(--pun-zap); color: var(--pun-on-fill); cursor: pointer; }

  .stage { position: relative; aspect-ratio: 1; }
  .panel { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 32px; background: var(--pun-lilac); box-shadow: var(--pun-pop-lg); }
  .panel::before { content: ""; position: absolute; inset: 0; background-image: var(--pun-dot-grid); background-size: 22px 22px; opacity: .15; }
  .ring { position: absolute; width: 66%; aspect-ratio: 1; border-radius: 50%; background: var(--pun-zap); border: var(--pun-stroke) solid #17121f; }
  .panel img { position: relative; width: 92%; height: auto; }
  .burst { position: absolute; right: -18px; top: -22px; width: 104px; height: 104px; display: grid; place-content: center; text-align: center; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 50%; background: var(--pun-gum); color: var(--pun-on-fill); box-shadow: var(--pun-pop); transform: rotate(10deg); font: 800 28px/1 var(--blume-font-display); letter-spacing: -.03em; }
  .burst small, .eq small { display: block; margin-top: 4px; font: 600 10.5px/1.2 var(--blume-font-mono); letter-spacing: 0; }
  .loose { position: absolute; left: -18px; bottom: 44px; padding: 10px 14px; background: var(--pun-card); border: var(--pun-stroke) solid var(--pun-outline); border-radius: 10px; box-shadow: var(--pun-pop); transform: rotate(-4deg); font: 600 13px/1 var(--blume-font-mono); }

  /* ribbon */
  .ribbon { overflow: hidden; margin: 0 -40px; background: #17121f; color: #fbf6ec; border-block: var(--pun-stroke) solid #17121f; transform: rotate(-1.5deg); }
  .ribbon-track { display: flex; gap: 36px; width: max-content; padding: 14px 0; font: 700 18px/1 var(--blume-font-display); animation: slide 32s linear infinite; }
  .ribbon-track span { display: inline-flex; align-items: center; gap: 36px; }
  .ribbon-track span:nth-child(3n+2) { color: var(--pun-lilac); }
  .ribbon-track span::after { content: ""; width: 12px; height: 18px; background: var(--pun-zap); clip-path: polygon(60% 0, 0 58%, 42% 58%, 30% 100%, 100% 38%, 58% 38%); }
  @keyframes slide { to { transform: translateX(-50%); } }

  /* tools */
  .tools { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; padding-top: 14px; }
  .tool { position: relative; display: flex; flex-direction: column; gap: 12px; min-height: 230px; padding: 24px 20px 20px; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 24px; background: var(--pun-card); box-shadow: var(--pun-pop); text-decoration: none; transform: rotate(var(--tilt)); transition: transform .15s ease, box-shadow .15s ease; }
  .tool:hover { transform: rotate(0deg) translate(-2px, -2px); box-shadow: var(--pun-pop-hover); }
  .tool .tag { position: absolute; top: -13px; right: 16px; box-shadow: var(--pun-pop-sm); }
  .tile { width: 48px; height: 48px; display: grid; place-items: center; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 16px; font: 800 22px/1 var(--blume-font-display); color: var(--pun-on-fill); }
  .tile.zap { background: var(--pun-zap); } .tile.lilac { background: var(--pun-lilac); } .tile.gum { background: var(--pun-gum); } .tile.mint { background: var(--pun-mint); }
  .tool h3 { font-size: 24px; line-height: 1.1; font-weight: 800; letter-spacing: -.02em; }
  .replaces { font: 500 11px/1.4 var(--blume-font-mono); color: var(--pun-ink-3); }
  .tool p { margin: 0; font-size: 14px; line-height: 1.45; color: var(--pun-ink-2); }
  .tool code { margin-top: auto; display: block; padding: 9px 12px; border-radius: 10px; background: var(--pun-code-bg); color: var(--pun-zap); font: 500 12px/1.2 var(--blume-font-mono); }

  /* race */
  .race { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: end; }
  .race h2 { margin-bottom: 0; }
  .mega { font: 800 clamp(120px, 18vw, 220px)/.8 var(--blume-font-display); letter-spacing: -.06em; margin-top: 24px; }
  .mega sup { font-size: .32em; vertical-align: top; position: relative; top: .25em; }
  .bench { margin: 0; padding: 24px 24px 16px; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 24px; background: var(--pun-card); box-shadow: var(--pun-pop-lg); }
  .bench-title, .bench figcaption { display: flex; justify-content: space-between; gap: 12px; font: 600 12px/1.3 var(--blume-font-mono); color: var(--pun-ink-3); }
  .bench-title { text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }
  .bench figcaption { font-weight: 500; font-size: 11px; margin-top: 12px; }
  .bench figcaption a { color: var(--blume-accent); }
  .lane { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: center; padding: 12px 0; border-bottom: 2px dashed var(--pun-hairline); }
  .lane:last-of-type { border-bottom: 0; }
  .who { font: 700 13px/1.25 var(--blume-font-mono); }
  .who small { display: block; font-weight: 400; font-size: 11px; color: var(--pun-ink-3); }
  .bar { position: relative; height: 40px; display: flex; align-items: center; }
  .fill { height: 100%; min-width: 40px; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 999px; }
  .fill.slow { background: var(--pun-stripe); } .fill.zap { background: var(--pun-zap); } .fill.gum { background: var(--pun-gum); }
  .val { margin-left: 12px; font: 700 15px/1 var(--blume-font-mono); white-space: nowrap; }
  .val.in { position: absolute; right: 18px; margin: 0; color: var(--pun-on-fill); }

  /* parity */
  .parity { display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: center; }
  .code { border: var(--pun-stroke) solid var(--pun-outline); border-radius: 24px; background: var(--pun-code-bg); color: var(--pun-code-ink); box-shadow: var(--pun-pop); overflow: hidden; }
  .code-bar { display: flex; justify-content: space-between; padding: 11px 16px; background: var(--pun-code-bar); font: 600 12px/1 var(--blume-font-mono); }
  .code-bar span:last-child { color: var(--pun-code-dim); }
  .code pre { margin: 0; padding: 18px 16px 20px; font: 500 13.5px/1.8 var(--blume-font-mono); background: none; border: 0; }
  .code .add { color: var(--pun-code-add); } .code .del { color: var(--pun-code-del); } .code .dim { color: var(--pun-code-dim); }
  .eq { width: 96px; height: 96px; display: grid; place-content: center; text-align: center; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 50%; background: var(--pun-zap); color: var(--pun-on-fill); box-shadow: var(--pun-pop); transform: rotate(10deg); font: 800 36px/1 var(--blume-font-display); }
  .score { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 40px; margin-top: 40px; padding: 20px 24px; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 24px; background: var(--pun-paper-2); }
  .score b { display: block; font: 800 40px/1 var(--blume-font-display); letter-spacing: -.03em; }
  .score span { font: 500 12px/1.3 var(--blume-font-mono); color: var(--pun-ink-3); }
  .score .btn { margin-left: auto; }

  /* cta */
  .cta { margin: 112px 0 96px; padding: 56px; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; position: relative; overflow: hidden; border: var(--pun-stroke) solid var(--pun-outline); border-radius: 32px; background: var(--pun-gum); box-shadow: var(--pun-pop-lg); }
  .cta::before { content: ""; position: absolute; inset: 0; background-image: var(--pun-dot-grid); background-size: 22px 22px; opacity: .15; }
  .cta h2 { position: relative; margin: 0; color: #17121f; }
  .cta .actions { position: relative; margin: 0; }

  @media (max-width: 960px) {
    .hero, .race { grid-template-columns: 1fr; gap: 40px; }
    .stage { max-width: 460px; width: 100%; justify-self: center; }
    .tools { grid-template-columns: 1fr 1fr; }
    .parity { grid-template-columns: 1fr; }
    .eq { justify-self: center; }
    .cta { grid-template-columns: 1fr; padding: 36px; }
  }
  @media (max-width: 560px) {
    .tools { grid-template-columns: 1fr; }
    .tool { transform: none; }
    .lane { grid-template-columns: 1fr; gap: 8px; }
    .burst { right: -6px; } .loose { left: -6px; }
    .score .btn { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ribbon-track { animation: none; }
    .btn, .tool, .btn .arrow { transition: none; }
  }
</style>
