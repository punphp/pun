{
    "fixer": "no_unneeded_import_alias",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\Import\\NoUnneededImportAliasFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/Import/NoUnneededImportAliasFixerTest.php",
    "case_count": 8,
    "tests": [
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
                    "type": "?string",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\Import\\NoUnneededImportAliasFixerTest",
            "body": "    public function testFix(string $expected, ?string $input = null): void\n    {\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": 0,
                    "args": [
                        "<?php use some\\ns\\{ClassA, ClassB, ClassC  };",
                        "<?php use some\\ns\\{ClassA, ClassB, ClassC as ClassC};"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 1,
                    "args": [
