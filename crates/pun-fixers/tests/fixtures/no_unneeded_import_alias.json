                        "<?php\n                use A\\B\\C as C, D\\E\\F as G;\n                use const X\\Y\\Z as Z1, U\\V\\W as W;\n                use function U\\V\\W\\FX as FX, U\\V\\W\\FY as FY;\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 2,
                    "args": [
                        "<?php\nuse F  ;\nuse X as x;\nuse const CA  ;\nuse function FW  ;\n            ",
                        "<?php\nuse F as F;\nuse X as x;\nuse const CA as CA;\nuse function FW as FW;\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 3,
                    "args": [
                        "<?php\nuse /* 1 */\\F  ;\nuse const \\CA/* 2 */  /* 3 */;\nuse /* 4 */ function/* 5 */  \\FW /* 6 */  /* 7 */ ;\n            ",
                        "<?php\nuse /* 1 */\\F as F;\nuse const \\CA/* 2 */ as CA/* 3 */;\nuse /* 4 */ function/* 5 */  \\FW /* 6 */ as /* 7 */ FW;\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 4,
                    "args": [
                        "<?php\nuse \\F\\B\\C  ;\nuse const \\X\\Y\\CA  ;\nuse function \\U\\V\\FW  ;\n            ",
                        "<?php\nuse \\F\\B\\C as C;\nuse const \\X\\Y\\CA as CA;\nuse function \\U\\V\\FW as FW;\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 5,
                    "args": [
                        "<?php use A\\B   ?> X <?php use C\\D; use E\\F   ?>",
                        "<?php use A\\B as B ?> X <?php use C\\D; use E\\F as F ?>"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 6,
                    "args": [
                        "<?php use A\\B   ?>",
                        "<?php use A\\B as B ?>"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 7,
