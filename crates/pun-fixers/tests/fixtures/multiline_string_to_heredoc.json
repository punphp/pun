                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "colliding closing marker - one",
                    "args": [
                        "<?php\n$a = <<<'EOD_'\nline1\nEOD\nline2\nEOD_;",
                        "<?php\n$a = 'line1\nEOD\nline2';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "colliding closing marker - two",
                    "args": [
