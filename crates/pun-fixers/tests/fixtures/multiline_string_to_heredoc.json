                        "<?php\n\"$a\n{$b['x']}\";\n'c\nd';\n\n\"$a\n$b\";\n\"$c\n$d\";\n\n'a';\n'b\nc';\n\n<<<'EOD'\nEOD;\n<<<EOD\n$a $b\nEOD;\n<<<'EOD'\nc d\nEOD;\n<<<EOD\n$a $b\nEOD;\n<<<EOD\n$a\n$b\nEOD;\n<<<'EOD'\n$c\n$d\nEOD;"
