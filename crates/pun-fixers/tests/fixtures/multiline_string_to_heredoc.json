                        "<?php\n$a = 'line1\n\\\\\n\\n\n\\'\n\\\\\\\\\\'\n\\\"\n\\\n';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "double quoted unescape",
                    "args": [
