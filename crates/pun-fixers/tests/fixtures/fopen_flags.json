{
    "fixer": "fopen_flags",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\FunctionNotation\\FopenFlagsFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/FunctionNotation/FopenFlagsFixerTest.php",
    "case_count": 24,
    "tests": [
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
                    "type": "?string",
                    "default": null
                },
                {
                    "name": "configuration",
                    "type": "array",
                    "default": []
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\FunctionNotation\\FopenFlagsFixerTest",
            "body": "    public function testFix(string $expected, ?string $input = null, array $configuration = []): void\n    {\n        $this->fixer->configure($configuration);\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": "missing \"b\"",
                    "args": [
                        "<?php\n                    $a = fopen($foo, 'rw+b');\n                ",
                        "<?php\n                    $a = fopen($foo, 'rw+');\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "has \"t\" and \"b\"",
                    "args": [
                        "<?php\n                    $a = \\fopen($foo, \"rw+b\");\n                ",
                        "<?php\n                    $a = \\fopen($foo, \"rw+bt\");\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "has \"t\" and no \"b\" and binary string mod",
                    "args": [
                        "<?php\n                    $a = fopen($foo, b'rw+b');\n                ",
                        "<?php\n                    $a = fopen($foo, b'trw+');\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "missing \"b\" but not configured",
                    "args": [
                        "<?php\n                    $a = fopen($foo, 'rw+');\n                ",
                        "<?php\n                    $a = fopen($foo, 'rw+t');\n                ",
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "\"t\" and superfluous \"b\"",
                    "args": [
                        "<?php\n                    $a = fopen($foo, 'r+');\n                    $a = fopen($foo, 'w+r');\n                    $a = fopen($foo, 'r+');\n                    $a = fopen($foo, 'w+r');\n                ",
                        "<?php\n                    $a = fopen($foo, 'r+bt');\n                    $a = fopen($foo, 'btw+r');\n                    $a = fopen($foo, 'r+tb');\n                    $a = fopen($foo, 'tbw+r');\n                ",
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "superfluous \"b\"",
                    "args": [
                        "<?php\n                    $a = fopen($foo, 'r+');\n                    $a = fopen($foo, 'w+r');\n                ",
                        "<?php\n                    $a = fopen($foo, 'r+b');\n                    $a = fopen($foo, 'bw+r');\n                ",
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "not simple flags with b_mode",
                    "args": [
                        "<?php $a = fopen($foo, \"t\".$a);"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "not simple flags without b_mode",
                    "args": [
                        "<?php $a = fopen($foo, \"t\".$a);",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "wrong # of arguments with b_mode",
                    "args": [
                        "<?php\n                    $b = fopen(\"br+\");\n                    $c = fopen($foo, \"w+\", 1, 2 , 3);\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "wrong # of arguments without b_mode",
                    "args": [
                        "<?php\n                    $b = fopen(\"br+\");\n                    $c = fopen($foo, \"w+\", 1, 2 , 3);\n                ",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "\"flags\" is too long (must be overridden) with b_mode",
                    "args": [
                        "<?php $d = fopen($foo, \"r+w+a+x+c+etXY\");"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "\"flags\" is too long (must be overridden) without b_mode",
                    "args": [
                        "<?php $d = fopen($foo, \"r+w+a+x+c+etXY\");",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "\"flags\" is too short (must be overridden) with b_mode",
                    "args": [
                        "<?php $d = fopen($foo, \"\");"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "\"flags\" is too short (must be overridden) without b_mode",
                    "args": [
                        "<?php $d = fopen($foo, \"\");",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "static method call with b_mode",
                    "args": [
                        "<?php $e = A::fopen($foo, \"w+\");"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "static method call without b_mode",
                    "args": [
                        "<?php $e = A::fopen($foo, \"w+\");",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "method call with b_mode",
                    "args": [
                        "<?php $f = $b->fopen($foo, \"r+\");"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "method call without b_mode",
                    "args": [
                        "<?php $f = $b->fopen($foo, \"r+\");",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "comments, PHPDoc and literal with b_mode",
                    "args": [
                        "<?php\n                    // fopen($foo, \"rw\");\n                    /* fopen($foo, \"rw\"); */\n                    echo(\"fopen($foo, \\\"rw\\\")\");\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "comments, PHPDoc and literal without b_mode",
                    "args": [
                        "<?php\n                    // fopen($foo, \"rw\");\n                    /* fopen($foo, \"rw\"); */\n                    echo(\"fopen($foo, \\\"rw\\\")\");\n                ",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "invalid flag values with b_mode",
                    "args": [
                        "<?php\n                $a = fopen($foo, '');\n                $a = fopen($foo, 'k');\n                $a = fopen($foo, 'kz');\n                $a = fopen($foo, 'k+');\n                $a = fopen($foo, '+k');\n                $a = fopen($foo, 'xct++');\n                $a = fopen($foo, 'w+r+r+');\n                $a = fopen($foo, '+btrw+');\n                $a = fopen($foo, 'b+rw');\n                $a = fopen($foo, 'bbrw+');\n                $a = fopen($foo, 'brw++');\n                $a = fopen($foo, '++brw');\n                $a = fopen($foo, 'ybrw+');\n                $a = fopen($foo, 'rr');\n                $a = fopen($foo, 'ロ');\n                $a = fopen($foo, 'ロ+');\n                $a = fopen($foo, 'rロ');\n                $a = \\fopen($foo, 'w+ロ');\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "invalid flag values without b_mode",
                    "args": [
                        "<?php\n                $a = fopen($foo, '');\n                $a = fopen($foo, 'k');\n                $a = fopen($foo, 'kz');\n                $a = fopen($foo, 'k+');\n                $a = fopen($foo, '+k');\n                $a = fopen($foo, 'xct++');\n                $a = fopen($foo, 'w+r+r+');\n                $a = fopen($foo, '+btrw+');\n                $a = fopen($foo, 'b+rw');\n                $a = fopen($foo, 'bbrw+');\n                $a = fopen($foo, 'brw++');\n                $a = fopen($foo, '++brw');\n                $a = fopen($foo, 'ybrw+');\n                $a = fopen($foo, 'rr');\n                $a = fopen($foo, 'ロ');\n                $a = fopen($foo, 'ロ+');\n                $a = fopen($foo, 'rロ');\n                $a = \\fopen($foo, 'w+ロ');\n                ",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "second argument not string with b_mode",
                    "args": [
                        "<?php\n                    echo \"abc\"; // to pass the candidate check\n                    $a = fopen($foo, 1);\n                    $a = fopen($foo, $a);\n                    $a = fopen($foo, null);\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "second argument not string without b_mode",
                    "args": [
                        "<?php\n                    echo \"abc\"; // to pass the candidate check\n                    $a = fopen($foo, 1);\n                    $a = fopen($foo, $a);\n                    $a = fopen($foo, null);\n                ",
                        null,
                        {
                            "b_mode": false
                        }
                    ]
                }
            ]
        }
    ]
}
