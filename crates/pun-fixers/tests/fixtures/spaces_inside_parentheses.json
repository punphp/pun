    "test_file": "php-cs-fixer/tests/Fixer/Whitespace/SpacesInsideParenthesesFixerTest.php",
    "case_count": 40,
    "tests": [
        {
            "method": "testInvalidConfiguration",
            "params": [
                {
                    "name": "wrongConfig",
                    "type": "array",
                    "default": null
                },
                {
                    "name": "expectedMessage",
                    "type": "string",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\Whitespace\\SpacesInsideParenthesesFixerTest",
            "body": "    public function testInvalidConfiguration(array $wrongConfig, string $expectedMessage): void\n    {\n        $this->expectException(InvalidFixerConfigurationException::class);\n        $this->expectExceptionMessageMatches($expectedMessage);\n\n        $this->fixer->configure($wrongConfig); // @phpstan-ignore argument.type\n    }\n",
            "cases": [
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "missing key",
                    "args": [
                        {
                            "a": 1
                        },
                        "#^\\[spaces_inside_parentheses\\] Invalid configuration: The option \"a\" does not exist\\. Defined options are: \"space\"\\.$#"
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "invalid value",
                    "args": [
                        {
                            "space": "double"
                        },
                        "#^\\[spaces_inside_parentheses\\] Invalid configuration: The option \"space\" with value \"double\" is invalid\\. Accepted values are: \"none\", \"single\"\\.$#"
                    ]
                }
            ]
        },
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
