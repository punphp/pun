            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": 0,
                    "args": [
                        "<?php\n\nclass Foo\n{\n    private function bar()\n    {\n        if (foo(\n            'foo' ,\n            'bar'    ,\n            [1, 2, 3],\n            'baz' // a comment just to mix things up\n        )) {\n            return 1;\n        };\n    }\n}\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 1,
                    "args": [
                        "<?php foo();",
                        "<?php foo( );"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 2,
                    "args": [
                        "<?php\nif (true) {\n    // if body\n}",
                        "<?php\nif ( true ) {\n    // if body\n}"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 3,
                    "args": [
                        "<?php\nif (true) {\n    // if body\n}",
