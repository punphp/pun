                        "<?php\nuse some\\a\\{ClassA, ClassB, ClassC as C};\nuse    function some\\b\\{fn_a, fn_b, fn_c};\nuse const/* group comment */some\\c\\{ConstA/**/as/**/ E   ,    ConstB   AS    D, \n// use.,{}\nConstC};\nuse A\\{B};\nuse D\\{E,F};\n                "
