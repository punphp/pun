                        "<?php\nif (is_array($d))\n    foreach ($d as $x)\n        (f($x) && g($x)) || h($x);\nelse\n    (f($d) && g($d)) || h($d);\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "do with a body starting with a parenthesis",
                    "args": [
