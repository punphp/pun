                    "args": [
                        "<?php\nnamespace Foo {\n    function printf($arg) {}\n}\n\nnamespace Bar {\n    use function Foo\\printf;\n    printf('bar');\n}"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "skip function cases",
                    "args": [
