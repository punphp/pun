                {
                    "provider": "provideFixCases",
                    "key": 17,
                    "args": [
                        "<?php echo $a . $b;\n                    echo $d . $e .   //\n                        $f;\n                    echo $a . $b?>\n                 <?php\n                    echo $c;\n                ",
                        "<?php echo $a.$b;\n                    echo $d    .            $e          .   //\n                        $f;\n                    echo $a   .                  $b?>\n                 <?php\n                    echo $c;\n                ",
