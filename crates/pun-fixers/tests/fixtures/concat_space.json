{
    "fixer": "concat_space",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\Operator\\ConcatSpaceFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/Operator/ConcatSpaceFixerTest.php",
    "case_count": 20,
    "tests": [
        {
            "method": "testInvalidConfiguration",
            "params": [
                {
                    "name": "configuration",
                    "type": "array",
                    "default": null
                },
                {
                    "name": "exceptionExpression",
                    "type": "string",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\Operator\\ConcatSpaceFixerTest",
            "body": "    public function testInvalidConfiguration(array $configuration, string $exceptionExpression): void\n    {\n        self::expectException(InvalidFixerConfigurationException::class);\n        self::expectExceptionMessageMatches($exceptionExpression);\n\n        $this->fixer->configure($configuration); // @phpstan-ignore argument.type\n    }\n",
            "cases": [
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "missing key",
                    "args": [
                        {
                            "a": 1
                        },
                        "#^\\[concat_space\\] Invalid configuration: The option \"a\" does not exist\\. Defined options are: \"spacing\"\\.$#"
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "invalid value",
                    "args": [
                        {
                            "spacing": "tabs"
                        },
                        "#^\\[concat_space\\] Invalid configuration: The option \"spacing\" with value \"tabs\" is invalid\\. Accepted values are: \"one\", \"none\"\\.$#"
                    ]
                }
            ]
        },
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
                    "type": "?string",
                    "default": null
                },
                {
                    "name": "configuration",
                    "type": "array",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\Operator\\ConcatSpaceFixerTest",
            "body": "    public function testFix(string $expected, ?string $input, array $configuration): void\n    {\n        $this->fixer->configure($configuration);\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": 0,
                    "args": [
                        "<?php $foo = \"a\".'b'.\"c\".\"d\".$e.($f + 1);",
                        "<?php $foo = \"a\" . 'b' .\"c\". \"d\" . $e.($f + 1);",
                        {
                            "spacing": "none"
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 1,
                    "args": [
                        "<?php $foo = 1 .\"foo\";",
                        "<?php $foo = 1 . \"foo\";",
                        {
                            "spacing": "none"
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 2,
                    "args": [
                        "<?php $foo = \"foo\". 1;",
                        "<?php $foo = \"foo\" . 1;",
                        {
                            "spacing": "none"
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 3,
                    "args": [
                        "<?php $foo = \"a\".\n\"b\";",
