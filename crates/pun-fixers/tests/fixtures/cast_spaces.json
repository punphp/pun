            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\CastNotation\\CastSpacesFixerTest",
            "body": "    public function testInvalidConfiguration(array $config, string $expectedMessage): void\n    {\n        $this->expectException(InvalidFixerConfigurationException::class);\n        $this->expectExceptionMessageMatches($expectedMessage);\n\n        $this->fixer->configure($config); // @phpstan-ignore argument.type\n    }\n",
            "cases": [
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "missing key",
                    "args": [
                        {
                            "a": 1
                        },
                        "#^\\[cast_spaces\\] Invalid configuration: The option \"a\" does not exist\\. Defined options are: \"space\"\\.$#"
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "invalid value",
                    "args": [
                        {
                            "space": "double"
                        },
                        "#^\\[cast_spaces\\] Invalid configuration: The option \"space\" with value \"double\" is invalid\\. Accepted values are: \"none\", \"single\"\\.$#"
                    ]
                }
            ]
        },
