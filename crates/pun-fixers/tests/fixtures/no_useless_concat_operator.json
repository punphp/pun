                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed . single",
                    "args": [
                        "<?php $b = \"{$a}Z\";",
                        "<?php $b = \"{$a}\".'Z';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "single . encapsed",
                    "args": [
                        "<?php $b = \"Y{$a}\";",
