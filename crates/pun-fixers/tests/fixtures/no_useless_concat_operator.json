{
    "fixer": "no_useless_concat_operator",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\Operator\\NoUselessConcatOperatorFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/Operator/NoUselessConcatOperatorFixerTest.php",
    "case_count": 35,
    "tests": [
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
                    "type": "?string",
                    "default": null
                },
                {
                    "name": "configuration",
                    "type": "array",
                    "default": {
                        "juggle_simple_strings": true
                    }
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\Operator\\NoUselessConcatOperatorFixerTest",
            "body": "    public function testFix(string $expected, ?string $input = null, array $configuration = ['juggle_simple_strings' => true]): void\n    {\n        $this->fixer->configure($configuration);\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": "single . single",
                    "args": [
                        "<?php $b = 'ab';",
                        "<?php $b = 'a'.'b';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "single . double",
                    "args": [
                        "<?php $b = \"ab\";",
                        "<?php $b = 'a'.\"b\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "double . single",
                    "args": [
                        "<?php $b = \"b\\na\";",
                        "<?php $b = \"b\\n\".'a';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "double . double",
                    "args": [
                        "<?php $b = \"bb\";",
                        "<?php $b = \"b\".\"b\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed . encapsed",
                    "args": [
                        "<?php $b = \"{$a}{$b}\";",
                        "<?php $b = \"{$a}\".\"{$b}\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed space. encapsed",
                    "args": [
                        "<?php $b = \"{$a1} {$b2}\";",
                        "<?php $b = \"{$a1} \".\"{$b2}\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed . space encapsed",
                    "args": [
