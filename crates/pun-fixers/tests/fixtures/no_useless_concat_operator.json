                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed . double",
                    "args": [
                        "<?php $b = \"{$a} XX\";",
                        "<?php $b = \"{$a} \".\"XX\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "double . encapsed",
                    "args": [
                        "<?php $b = \"XCV{$a}\";",
                        "<?php $b = \"XCV\".\"{$a}\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed spaced . double",
                    "args": [
                        "<?php $b = \"{$a} V PO\";",
                        "<?php $b = \"{$a} V \".\"PO\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "double . space encapsed",
                    "args": [
                        "<?php $b = \"DSA   XX {$a}\";",
                        "<?php $b = \"DSA\".\"   XX {$a}\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed followed by simple double quoted 1",
                    "args": [
                        "<?php echo \"Hello, {$fruit}s.\";",
