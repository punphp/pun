                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "encapsed followed by simple double quoted 2",
                    "args": [
                        "<?php echo \"Hello.He drank some juice made of {$fruit}s.Bye $user!\" /*1*//*2*/ /*3*//*4*/;",
                        "<?php echo 'Hello.' /*1*/ . /*2*/ \"He drank some juice made of {$fruit}s.\"/*3*/./*4*/\"Bye $user!\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 0,
                    "args": [
                        "<?php\n$string = \"foobar\";\necho \"char @ -4 \\\"[$string[-2]]\\\"!\";\n",
                        "<?php\n$string = \"foobar\";\necho \"char @ -4 \\\"[$string[-2]\".\"]\\\"!\";\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "double quote concat double quote + comment",
                    "args": [
                        "<?php $fi = \"lk\" /* 1 *//* 2 */ ;",
                        "<?php $fi = \"l\" /* 1 */ . /* 2 */ \"k\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "empty concat empty",
                    "args": [
                        "<?php $aT = \"\";",
                        "<?php $aT = \"\".\"\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "multiple fixes",
                    "args": [
                        "<?php $f0 = \"abc | defg\";",
                        "<?php $f0 = \"a\".\"b\".\"c | \".\"d\".\"e\".\"f\".\"g\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "linebreak with indent inside",
                    "args": [
                        "<?php\n$text1 = \"intro:   |   |\".\"\n               line 2 indent\";",
                        "<?php\n$text1 = \"intro:   |\".\"   |\".\"\n               line 2 indent\".\"\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "linebreak with indent inside + comment",
                    "args": [
                        "<?php\n$text2 = \"intro:      \".\" #a\n               line 2 indent\";",
                        "<?php\n$text2 = \"intro:   \".\"   \".\" #a\n               line 2 indent\".\"\";"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "do not fix",
                    "args": [
                        "<?php\n                $a0x = $b . \"c\";\n                $a1x = \"c\" . $b;\n                $b2x = foo() . \"X\";\n                $b3x = foo() . 'Y';\n                $b4x = \"Z\" . foo();\n                $b5x = 'b' . foo();\n                $b6x = 'X  \\n ' . \"\\n\\t\";\n                $b7x = \"\\n\\t\" . 'X $a';\n                $b7x = \"abc\". 1;\n                $b7x = \"def\". 1.2;\n                // bin string\n                $f202 = b\"a\".\"b\";\n                $f201 = b\"a\".b\"b\";\n                $f203 = \"a\".B\"b\";\n                echo b\"He drank some juice made of {$fruit}s.\".b\" Sliced the {$fruit}s.\";\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "do not fix if the execution result would be different",
                    "args": [
                        "<?php\n                echo \"abc $d\" . \"[$e]\";\n                echo \"abc $d\" . \"[3]\";\n                echo \"abc $d\" . '[3]';\n                echo \"abc $d\" . \"->e\";\n                echo \"abc $d\" . '->e';\n                echo \"abc $d\" . \"->$e\";\n                echo \"abc $d\" . \"?->e\";\n                echo \"abc $d\" . \"?->$e\";\n                echo \"abc $d\" . '?->e';\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "do not fix if variables would be broken",
                    "args": [
                        "<?php\n                echo \"abc $d\" . \"e $f\";\n                echo \"abc $d\" . \"e\";\n                echo \"abc $d\" . \"　e\"; // contains full-width space\n                echo \"abc $d\" . 'e';\n                echo \"abc $d\" . '　e'; // contains full-width space\n                echo \"abc $d\" . \"😃\"; // with emoji\n                echo \"私の名前は$name\" . \"です\"; // multibyte characters (Japanese)\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "fix if variables would not be broken",
                    "args": [
                        "<?php\n                echo \"$a b\";\n                echo \"$a bcde\";\n                echo \"abc ${d}e\";\n                echo \"abc $d-efg\";\n                echo \"$a bcdef\";\n                echo \"abc ${d}ef\";\n                echo \"abc $d-efgh\";\n                echo \"abc $d-$e\";\n            ",
                        "<?php\n                echo \"$a\" . \" b\";\n                echo \"$a bc\" . \"de\";\n                echo \"abc ${d}\" . \"e\";\n                echo \"abc $d\" . \"-efg\";\n                echo \"$a bc\" . 'def';\n                echo \"abc ${d}\" . 'ef';\n                echo \"abc $d\" . '-efgh';\n                echo \"abc $d\" . \"-$e\";\n            "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "single quote concat single quote but with line break after",
                    "args": [
                        "<?php $fh = 'x'. // some comment\n'y';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "single quote concat single quote but with line break before",
                    "args": [
                        "<?php $ff = 'x' // some comment\n.'y';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "linebreak without indent inside",
