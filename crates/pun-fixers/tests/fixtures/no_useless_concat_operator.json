                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "linebreak before concat + comment",
                    "args": [
                        "<?php\n$a = 'The first line of some block.'\n.'The second line' // some comment about this line\n.'3rd line'\n;\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "concat without linebreak, followed by one with linebreak",
                    "args": [
                        "<?php\n$foo = 'ab'\n    . 'c';",
                        "<?php\n$foo = 'a' . 'b'\n    . 'c';"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 1,
                    "args": [
