            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\ClassNotation\\FinalInternalClassFixerTest",
            "body": "    public function testFix(string $expected, ?string $input = null, array $configuration = []): void\n    {\n        $this->fixer->configure($configuration);\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": "fix multiple classes",
                    "args": [
                        "<?php /** @internal */\nfinal class class1\n{\n}\n/** @internal */\nfinal class class2\n{\n}\n/** @internal */\nfinal class class3\n{\n}\n/** @internal */\nfinal class class4\n{\n}\n/** @internal */\nfinal class class5\n{\n}\n/** @internal */\nfinal class class6\n{\n}\n/** @internal */\nfinal class class7\n{\n}\n/** @internal */\nfinal class class8\n{\n}\n/** @internal */\nfinal class class9\n{\n}\n",
                        "<?php /** @internal */\nclass class1\n{\n}\n/** @internal */\nclass class2\n{\n}\n/** @internal */\nclass class3\n{\n}\n/** @internal */\nclass class4\n{\n}\n/** @internal */\nclass class5\n{\n}\n/** @internal */\nclass class6\n{\n}\n/** @internal */\nclass class7\n{\n}\n/** @internal */\nclass class8\n{\n}\n/** @internal */\nclass class9\n{\n}\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 0,
                    "args": [
                        "<?php\n\n/** @internal */\nfinal class class1\n{\n}\n\ninterface A {}\ntrait B{}\n\n/** @internal */\nfinal class class2\n{\n}\n",
                        "<?php\n\n/** @internal */\nclass class1\n{\n}\n\ninterface A {}\ntrait B{}\n\n/** @internal */\nclass class2\n{\n}\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 1,
                    "args": [
                        "<?php\n/** @internal */\nfinal class class1\n{\n}\n\n/** @internal */\nfinal class class2\n{\n}\n\n/**\n * @internal\n * @final\n */\nclass class3\n{\n}\n\n/**\n * @internal\n */\nabstract class class4 {}\n",
                        "<?php\n/** @internal */\nfinal class class1\n{\n}\n\n/** @internal */\nclass class2\n{\n}\n\n/**\n * @internal\n * @final\n */\nclass class3\n{\n}\n\n/**\n * @internal\n */\nabstract class class4 {}\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 2,
                    "args": [
                        "<?php\n                    /**\n                     * @ annotation_with_space_after_at_sign\n                     */\n                    class A {}\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "indent before `class`",
                    "args": [
                        "<?php /** @internal */\n                    final class class1\n                    {\n                    }",
                        "<?php /** @internal */\n                    class class1\n                    {\n                    }"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "multiple classes, first with internal annotation and second without internal annotation",
                    "args": [
                        "<?php\n\n/** @internal */\nfinal class Foo {}\n\nclass Bar {}\n",
                        "<?php\n\n/** @internal */\nclass Foo {}\n\nclass Bar {}\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "multiple classes, first without internal annotation and second with internal annotation",
                    "args": [
                        "<?php\n\nclass Foo {}\n\n/** @internal */\nfinal class Bar {}\n",
                        "<?php\n\nclass Foo {}\n\n/** @internal */\nclass Bar {}\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 3,
                    "args": [
                        "<?php\n/** @CUSTOM */final class A{}",
                        "<?php\n/** @CUSTOM */class A{}",
                        {
                            "include": [
                                "@Custom"
                            ]
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 4,
                    "args": [
                        "<?php\n/**\n * @CUSTOM\n * @abc\n */\nfinal class A{}\n\n/**\n * @CUSTOM\n */\nfinal class B{}\n",
                        "<?php\n/**\n * @CUSTOM\n * @abc\n */\nclass A{}\n\n/**\n * @CUSTOM\n */\nclass B{}\n",
                        {
                            "include": [
                                "@Custom",
                                "@abc"
                            ]
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 5,
                    "args": [
                        "<?php\n/**\n * @CUSTOM\n * @internal\n */\n final class A{}\n\n/**\n * @CUSTOM\n * @internal\n * @other\n */\n final class B{}\n\n/**\n * @CUSTOM\n * @internal\n * @not-fix\n */\n class C{}\n",
                        "<?php\n/**\n * @CUSTOM\n * @internal\n */\n class A{}\n\n/**\n * @CUSTOM\n * @internal\n * @other\n */\n class B{}\n\n/**\n * @CUSTOM\n * @internal\n * @not-fix\n */\n class C{}\n",
                        {
                            "include": [
                                "@Custom",
                                "@internal"
                            ],
                            "exclude": [
                                "@not-fix"
                            ]
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 6,
                    "args": [
                        "<?php\n/**\n * @internal\n */\nfinal class A{}\n\n/**\n * @abc\n */\nclass B{}\n",
                        "<?php\n/**\n * @internal\n */\nclass A{}\n\n/**\n * @abc\n */\nclass B{}\n",
                        {
                            "exclude": [
                                "abc"
                            ]
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 7,
                    "args": [
                        "<?php final class A{}",
                        "<?php class A{}",
                        {
                            "consider_absent_docblock_as_internal_class": true
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "class with annotation with matching include and partial matching exclude",
                    "args": [
                        "<?php\n\n/** @HelloWorld */\nfinal class Foo {}\n",
                        "<?php\n\n/** @HelloWorld */\nclass Foo {}\n",
                        {
                            "include": [
                                "HelloWorld"
                            ],
                            "exclude": [
                                "Hello"
                            ]
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 8,
                    "args": [
                        "<?php\n/** @internal */\n$a = new class (){};"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 9,
                    "args": [
                        "<?php\n/** @internal */\n$a = new class{};"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 10,
                    "args": [
                        "<?php $object = new /**/ class(){};"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "old config",
                    "args": [
                        "<?php\n                /** @include */\n                final class Foo {}\n            ",
                        "<?php\n                /** @include */\n                class Foo {}\n            ",
