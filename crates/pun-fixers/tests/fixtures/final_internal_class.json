        {
            "method": "testInvalidConfiguration",
            "params": [
                {
                    "name": "config",
                    "type": "array",
                    "default": null
                },
                {
                    "name": "exceptionExpression",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "deprecationMessage",
                    "type": "?string",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\ClassNotation\\FinalInternalClassFixerTest",
            "body": "    public function testInvalidConfiguration(array $config, string $exceptionExpression, ?string $deprecationMessage = null): void\n    {\n        $this->expectException(InvalidFixerConfigurationException::class);\n        $this->expectExceptionMessageMatches($exceptionExpression);\n        if (null !== $deprecationMessage) {\n            $this->expectDeprecation($deprecationMessage);\n        }\n\n        $this->fixer->configure($config); // @phpstan-ignore argument.type\n    }\n",
            "cases": [
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "same annotation in both lists",
                    "args": [
                        {
                            "include": [
                                "@internal123",
                                "a"
                            ],
                            "exclude": [
                                "@internal123",
                                "b"
                            ]
                        },
                        "#^\\[final_internal_class\\] Annotation cannot be used in both \"include\" and \"exclude\" list, got duplicates\\: \"internal123\"\\.$#"
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "both new and old include set",
                    "args": [
                        {
                            "annotation_include": [
                                "@internal",
                                "a"
                            ],
                            "include": [
                                "@internal",
                                "b"
                            ]
                        },
                        "#^\\[final_internal_class\\] Configuration cannot contain deprecated option \"annotation_include\" and new option \"include\"\\.$#",
                        "Option \"annotation_include\" for rule \"final_internal_class\" is deprecated and will be removed in version 4.0. Use \"include\" to configure PHPDoc annotations tags and attributes."
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "both new and old exclude set",
                    "args": [
                        {
                            "annotation_exclude": [
                                "@internal",
                                "a"
                            ],
                            "exclude": [
                                "@internal",
                                "b"
                            ]
                        },
                        "#^\\[final_internal_class\\] Configuration cannot contain deprecated option \"annotation_exclude\" and new option \"exclude\"\\.$#",
                        "Option \"annotation_exclude\" for rule \"final_internal_class\" is deprecated and will be removed in version 4.0. Use \"exclude\" to configure PHPDoc annotations tags and attributes."
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "empty value",
                    "args": [
                        {
                            "include": [
                                ""
                            ]
                        },
                        "#^\\[final_internal_class\\] Invalid configuration\\: The option \"include\" with value array is invalid\\.$#"
                    ]
                }
            ]
        },
