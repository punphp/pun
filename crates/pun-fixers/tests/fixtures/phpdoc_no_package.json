{
    "fixer": "phpdoc_no_package",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\Phpdoc\\PhpdocNoPackageFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/Phpdoc/PhpdocNoPackageFixerTest.php",
    "case_count": 4,
    "tests": [
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
                    "type": "?string",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\Phpdoc\\PhpdocNoPackageFixerTest",
            "body": "    public function testFix(string $expected, ?string $input = null): void\n    {\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": "package",
                    "args": [
                        "<?php\n    /**\n     */\n",
                        "<?php\n    /**\n     * @package Foo\\Bar\n     */\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "subpackage",
