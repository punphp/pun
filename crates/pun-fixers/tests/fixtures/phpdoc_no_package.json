                },
                {
                    "provider": "provideFixCases",
                    "key": "many",
                    "args": [
                        "<?php\n/**\n * Hello!\n */\n",
                        "<?php\n/**\n * Hello!\n * @package\n * @subpackage\n */\n"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "do nothing",
                    "args": [
