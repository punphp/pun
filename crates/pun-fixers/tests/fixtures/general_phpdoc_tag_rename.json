                                "link": "b"
                            },
                            "case_sensitive": true
                        },
                        "[general_phpdoc_tag_rename] Invalid configuration: Cannot change tag \"b\" to tag \"see\", as the tag \"see\" is configured to be replaced to \"link\"."
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": 5,
                    "args": [
                        {
                            "replacements": {
                                "see": "link",
                                "link": "b"
