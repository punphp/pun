            "declared_in": "PhpCsFixer\\Tests\\Fixer\\NamespaceNotation\\CleanNamespaceFixerTest",
            "body": "    public function testFix(string $expected, string $input): void\n    {\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
