                        "<?php use function Foo \\ iter /* A */ \\ { range, map, filter, apply, reduce, foo \\ operator };\nclass Foo\n{\n    private function foo1(): \\Exception   \\ /* 1 */  A /** 2 */   // trailing comment\n    {\n    }\n\n    private function foo2(): \\Exception // trailing comment\n    {\n    }\n}"
                    ]
                }
            ]
        }
    ]
