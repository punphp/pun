    },
    {
        "fixer": "binary_operator_spaces",
        "config": {
            "operators": {
                "=": "align_single_space"
            }
        },
        "input": "<?php\nfunction foo() {\n    $a = Foo::class;\n    $bbb = 2;\n}\n$x= 1;\n$yy = 2;\n",
        "expected": "<?php\nfunction foo() {\n    $a   = Foo::class;\n    $bbb = 2;\n}\n$x  = 1;\n$yy = 2;\n"
    },
    {
        "fixer": "binary_operator_spaces",
        "config": {
            "operators": {
                "=>": "align_single_space"
            }
        },
        "input": "<?php\n$a = [\n\"a\"\n=> 1,\n\"bb\" => 2,\n];\n",
        "expected": "<?php\n$a = [\n\"a\"\n     => 1,\n\"bb\" => 2,\n];\n"
    }
