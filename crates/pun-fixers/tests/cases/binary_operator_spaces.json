[
    {
        "fixer": "binary_operator_spaces",
        "config": {
            "operators": {
                "=>": "align"
            }
        },
        "input": "<?php\n$a = [\n    'a' => 1,['x' => 1],\n    'bbb' => 2,array('y' => 2),\n    'cc' => 3,\n];\n",
