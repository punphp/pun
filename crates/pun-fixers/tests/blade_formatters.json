        "expected": "<div>__PINT_BLADE_0__</div>\n<script>__PINT_BLADE_1__;\nconst a = __PINT_BLADE_2__; const b = 'a\\'b';\nxzzy; a@b.c; @ ; __PINT_BLADE_3__; __PINT_BLADE_4__\n__PINT_BLADE_5__;\n__PINT_BLADE_6__;\n@empty x\nconst c = __PINT_BLADE_7__;\n@json($a)\n__PINT_BLADE_8__;\n</script>\n<style>\na { color: __PINT_BLADE_9__; }\n--pint-blade-10: 1;\n.x { --pint-blade-11: 1; }\n</style>\n<script>__PINT_BLADE_12__;</script>\n<script>@if(</script>\n<script>@if($a) x</script>\n<script>@php no end</script>\n<script>{{-- open</script>\n<script>__PINT_BLADE_13__</script>",
