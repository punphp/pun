{
    "fixer": "multiline_comment_opening_closing",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\Comment\\MultilineCommentOpeningClosingFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/Comment/MultilineCommentOpeningClosingFixerTest.php",
    "case_count": 10,
    "tests": [
        {
            "method": "testFix",
            "params": [
