                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 4,
                    "args": [
                        "<?php /* Closing comment */",
                        "<?php /* Closing comment ***/"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 5,
                    "args": [
                        "<?php /**/",
                        "<?php /***/"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 6,
                    "args": [
                        "<?php /**/",
                        "<?php /********/"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 7,
                    "args": [
                        "<?php\n\n/*\n * WUT\n */",
                        "<?php\n\n/********\n * WUT\n ********/"
