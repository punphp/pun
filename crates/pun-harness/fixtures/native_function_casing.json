                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 12,
                    "args": [
                        "<?php fOoO();"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 13,
                    "args": [
                        "<?php\n                    namespace Foo {\n                        function &Next() {\n                            return prev(-1);\n                        }\n                    }"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 14,
                    "args": [
                        "<?php\n                    $next1 = & next($array1);\n                    $next2 = & \\next($array2);\n                ",
                        "<?php\n                    $next1 = & Next($array1);\n                    $next2 = & \\Next($array2);\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 15,
                    "args": [
                        "<?php\n                    namespace Foo;\n                    use function MyStuff\\StrToLower;\n                    class Bar {\n                        public function getName() {\n                            return StrToLower($this->name);\n                        }\n                    }"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 16,
                    "args": [
                        "<?php\n                    echo \\sqrt(4 , );\n                ",
