{
    "fixer": "native_function_casing",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\Casing\\NativeFunctionCasingFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/Casing/NativeFunctionCasingFixerTest.php",
    "case_count": 20,
    "tests": [
        {
            "method": "testFix",
