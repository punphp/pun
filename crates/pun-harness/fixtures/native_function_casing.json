            "body": "    public function testFix(string $expected, ?string $input = null): void\n    {\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": 0,
                    "args": [
                        "<?php\n                namespace Bar {\n                    function STRLEN($str) {\n                        return \"overridden\" . \\strlen($str);\n                    }\n                }\n\n                namespace {\n                    echo \\Bar\\STRLEN(\"xxx\");\n                }"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 1,
                    "args": [
                        "<?php\n                    echo strtolower(\"hello 1\");\n                ",
