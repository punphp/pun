                    "args": [
                        "<?php\n                    class Test{\n                        public function gettypE()\n                        {\n                            return 1;\n                        }\n\n                        function sqrT($a)\n                        {\n                        }\n\n                        function &END($a)\n                        {\n                        }\n                    }\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
