                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 3,
                    "args": [
                        "<?php\n                    echo strtolower /**/   (\"hello 3\");\n                ",
                        "<?php\n                    echo STRTOLOWER /**/   (\"hello 3\");\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 4,
                    "args": [
                        "<?php\n                    echo \\sqrt(4);\n                ",
                        "<?php\n                    echo \\sQrT(4);\n                "
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": 5,
                    "args": [
                        "<?php\n                    echo \"1\".\\sqrt(\"hello 5\");\n                ",
