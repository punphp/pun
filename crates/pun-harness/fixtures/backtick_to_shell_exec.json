{
    "fixer": "backtick_to_shell_exec",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\Alias\\BacktickToShellExecFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/Alias/BacktickToShellExecFixerTest.php",
    "case_count": 5,
    "tests": [
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
                    "type": "?string",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\Alias\\BacktickToShellExecFixerTest",
            "body": "    public function testFix(string $expected, ?string $input = null): void\n    {\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": "plain",
                    "args": [
                        "<?php shell_exec(\"ls -lah\");",
                        "<?php `ls -lah`;"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "with variables",
                    "args": [
                        "<?php shell_exec(\"$var1 ls ${var2} -lah {$var3} file1.txt {$var4[0]} file2.txt {$var5->call()}\");",
                        "<?php `$var1 ls ${var2} -lah {$var3} file1.txt {$var4[0]} file2.txt {$var5->call()}`;"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "with single quote",
                    "args": [
                        "<?php\n`echo a\\'b`;\n`echo 'ab'`;"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "with double quote",
                    "args": [
                        "<?php\n`echo a\\\"b`;\n`echo 'a\"b'`;"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "with backtick",
                    "args": [
                        "<?php\n`echo 'a\\`b'`;\n`echo a\\\\\\`b`;"
                    ]
                }
            ]
        }
    ]
}
