                        "<?php\nnamespace space13 {\n    echo strlen(\"in 1\");\n}\n\nnamespace space2 {\n    echo strlen(\"in 2\");\n}\n\nnamespace { // global\n    echo strlen(\"global 1\");\n}\n",
