                        "<?php\n                    // do not fix\n                    $a = strrev($a);\n                    $a .= str_repeat($a, 4);\n                    $b = \\already_prefixed_function();\n                    // fix\n                    $c = get_class($d);\n                    $e = intval($f);\n                ",
