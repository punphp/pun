            "body": "    public function testInvalidConfiguration(array $configuration, string $expectedExceptionMessage): void\n    {\n        $this->expectException(InvalidFixerConfigurationException::class);\n        $this->expectExceptionMessage($expectedExceptionMessage);\n\n        $this->fixer->configure($configuration); // @phpstan-ignore argument.type\n    }\n",
            "cases": [
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "unknown key",
                    "args": [
                        {
                            "foo": "bar"
                        },
                        "[native_function_invocation] Invalid configuration: The option \"foo\" does not exist."
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "null",
                    "args": [
                        {
                            "exclude": [
                                null
                            ]
                        },
                        "[native_function_invocation] Invalid configuration: The option \"exclude\" with value array is expected to be of type \"string[]\", but one of the elements is of type \"null\"."
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "false",
                    "args": [
                        {
                            "exclude": [
                                false
                            ]
                        },
