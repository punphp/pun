                    "provider": "provideFixCases",
                    "key": "newlines (\\r\\n) around parentheses",
                    "args": [
                        "<?php declare(strict_types = 1);",
                        "<?php declare\r\n            (\r\n                strict_types = 1\r\n            );"
                    ]
                }
            ]
        }
    ]
