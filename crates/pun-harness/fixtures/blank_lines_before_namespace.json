{
    "fixer": "blank_lines_before_namespace",
    "test_class": "PhpCsFixer\\Tests\\Fixer\\NamespaceNotation\\BlankLinesBeforeNamespaceFixerTest",
    "test_file": "php-cs-fixer/tests/Fixer/NamespaceNotation/BlankLinesBeforeNamespaceFixerTest.php",
    "case_count": 14,
    "tests": [
        {
            "method": "testFix",
            "params": [
                {
                    "name": "expected",
                    "type": "string",
                    "default": null
                },
                {
                    "name": "input",
                    "type": "?string",
                    "default": null
                },
                {
                    "name": "configuration",
                    "type": "?array",
                    "default": []
                },
                {
                    "name": "whitespacesConfig",
                    "type": "?PhpCsFixer\\WhitespacesFixerConfig",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\NamespaceNotation\\BlankLinesBeforeNamespaceFixerTest",
            "body": "    public function testFix(\n        string $expected,\n        ?string $input = null,\n        ?array $configuration = [],\n        ?WhitespacesFixerConfig $whitespacesConfig = null\n    ): void {\n        $this->fixer->configure($configuration);\n        $this->fixer->setWhitespacesConfig($whitespacesConfig ?? new WhitespacesFixerConfig());\n        $this->doTest($expected, $input);\n    }\n",
            "cases": [
                {
                    "provider": "provideFixCases",
                    "key": "multiple blank lines between namespace declaration and PHP opening tag",
                    "args": [
                        "<?php\n\n\n\nnamespace X;",
                        "<?php\nnamespace X;",
                        {
                            "min_line_breaks": 4,
                            "max_line_breaks": 4
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "multiple blank lines between namespace declaration and comment",
                    "args": [
                        "<?php\n/* Foo */\n\n\nnamespace X;",
                        "<?php\n/* Foo */\nnamespace X;",
                        {
                            "min_line_breaks": 3,
                            "max_line_breaks": 3
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "multiple blank lines within min and max line breaks range",
                    "args": [
                        "<?php\n\n\n\nnamespace X;",
                        null,
                        {
                            "min_line_breaks": 3,
                            "max_line_breaks": 5
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "multiple blank lines with fewer line breaks than minimum",
                    "args": [
                        "<?php\n\n\nnamespace X;",
                        "<?php\n\nnamespace X;",
                        {
                            "min_line_breaks": 3,
                            "max_line_breaks": 5
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "multiple blank lines with more line breaks than maximum",
                    "args": [
                        "<?php\n\n\nnamespace X;",
                        "<?php\n\n\n\n\nnamespace X;",
                        {
                            "min_line_breaks": 1,
                            "max_line_breaks": 3
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "enforce namespace at the same line as opening tag",
                    "args": [
                        "<?php namespace X;",
                        "<?php\n\n\n\n\nnamespace X;",
                        {
                            "min_line_breaks": 0,
                            "max_line_breaks": 0
                        }
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "no newline",
                    "args": [
                        "<?php\n\nnamespace X;",
                        "<?php namespace X;"
                    ]
                },
                {
                    "provider": "provideFixCases",
                    "key": "no newline with additional spaces",
                    "args": [
                        "<?php\n\nnamespace X;",
                        "<?php   namespace X;"
                    ]
                }
            ]
        },
        {
            "method": "testInvalidConfiguration",
            "params": [
                {
                    "name": "configuration",
                    "type": "array",
                    "default": null
                }
            ],
            "requires_php": null,
            "declared_in": "PhpCsFixer\\Tests\\Fixer\\NamespaceNotation\\BlankLinesBeforeNamespaceFixerTest",
            "body": "    public function testInvalidConfiguration(array $configuration): void\n    {\n        $this->expectException(InvalidFixerConfigurationException::class);\n        $this->fixer->configure($configuration); // @phpstan-ignore argument.type\n    }\n",
            "cases": [
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "min not integer",
                    "args": [
                        {
                            "min_line_breaks": true,
                            "max_line_breaks": 2
                        }
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "max not integer",
                    "args": [
                        {
                            "min_line_breaks": 1,
                            "max_line_breaks": "two and a half"
                        }
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "min higher than max",
                    "args": [
                        {
                            "min_line_breaks": 4,
                            "max_line_breaks": 2
                        }
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "min lower than 0",
                    "args": [
                        {
                            "min_line_breaks": -2,
                            "max_line_breaks": 2
                        }
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "max lower than 0",
                    "args": [
                        {
                            "min_line_breaks": -4,
                            "max_line_breaks": -2
                        }
                    ]
                },
                {
                    "provider": "provideInvalidConfigurationCases",
                    "key": "extra option",
                    "args": [
                        {
                            "min_line_breaks": 1,
                            "max_line_breaks": 3,
                            "average_line_breaks": 2
                        }
                    ]
                }
            ]
        }
    ]
}
