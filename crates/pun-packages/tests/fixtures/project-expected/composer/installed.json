{
    "packages": [
        {
            "name": "acme/lib",
            "version": "1.2.0",
            "version_normalized": "1.2.0.0",
            "dist": {
                "type": "path",
                "url": "packages/lib",
                "reference": "7aeb9537b4372d3b9b5a97c1da216175f3964bf7"
            },
            "require": {
                "ext-json": "*",
                "php": "^8.2"
            },
            "provide": {
                "psr/log-implementation": "3.0"
            },
            "bin": [
                "bin/lib"
            ],
            "type": "library",
            "installation-source": "dist",
            "autoload": {
                "psr-4": {
                    "Acme\\Lib\\": "src/"
                },
                "files": [
                    "src/functions.php"
                ]
            },
            "transport-options": {
                "relative": true
            },
            "install-path": "../acme/lib"
        },
        {
            "name": "acme/tools",
            "version": "0.3.1",
            "version_normalized": "0.3.1.0",
            "dist": {
                "type": "path",
                "url": "packages/tools",
                "reference": "a6d854dda27357c0e870f612995cbea12f20d200"
            },
            "require": {
                "acme/lib": "^1.0"
            },
            "replace": {
                "acme/old-tools": "self.version"
            },
            "bin": [
                "bin/tool.sh"
            ],
            "type": "library",
            "installation-source": "dist",
            "autoload": {
                "psr-0": {
                    "Acme_Tools_": "lib/"
                },
                "classmap": [
                    "legacy/"
