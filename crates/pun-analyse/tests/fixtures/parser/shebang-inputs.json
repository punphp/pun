{
    "namespace-same-eof": "#!php<?php namespace N {}",
    "namespace-same-lf": "#!php<?php namespace N {}\n",
    "namespace-same-crlf": "#!php<?php namespace N {}\r\n",
    "namespace-same-cr": "#!php<?php namespace N {}\r",
    "namespace-before-lf": "#!php\n<?php namespace N {}",
    "namespace-before-crlf": "#!php\r\n<?php namespace N {}",
    "namespace-before-cr": "#!php\r<?php namespace N {}",
    "namespace-ordinary-inline": "text<?php namespace N {}",
    "namespace-raw-leading-comment": "/* leading */#!php<?php namespace N {}",
    "namespace-php-leading-comment": "<?php /* leading */ ?>#!php\n<?php namespace N {}",
    "namespace-comment-after-shebang": "#!php\n<?php /* leading */ namespace N {}",
    "namespace-space-before-shebang": " #!php\n<?php namespace N {}",
    "namespace-extra-inline": "#!php\ntext<?php namespace N {}",
    "namespace-extra-inline-crlf": "#!php\r\ntext<?php namespace N {}",
    "void-parameter": "#!php<?php function bad(void $value) {}",
    "void-before-namespace": "#!php<?php function bad(void $value) {} namespace N {}",
    "missing-function-eof": "#!php<?php missing_shebang_control();",
    "missing-function-lf": "#!php<?php missing_shebang_control();\n",
    "missing-function-crlf": "#!php<?php missing_shebang_control();\r\n",
    "missing-function-cr": "#!php<?php missing_shebang_control();\r",
    "missing-function-next-line": "#!php<?php\nmissing_shebang_control();\n",
    "missing-function-after-cr": "#!php\r<?php missing_shebang_control();",
    "missing-function-after-lf": "#!php\n<?php missing_shebang_control();",
    "missing-function-after-crlf": "#!php\r\n<?php missing_shebang_control();",
    "echo-tag": "#!php<?= missing_shebang_control(); ?>",
    "no-opening-tag": "#!php",
    "opening-tag-at-eof": "#!php<?php"
}
