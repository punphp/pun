{
    "bare-eof": "<?php }",
    "newline": "<?php\n}\n",
    "crlf": "<?php\r\n}\r\n",
    "comments": "<?PHP\t/* ignored } */\n// ignored }\n# ignored }\n/** ignored } */\n}\n",
    "control-bytes-in-comments": "<?php\n/* \u000b\u000c } */\n}\n",
    "blank-lines": "<?php\n\n  \t\n}\n",
    "repeated-braces": "<?php\n}\n}\n}\n",
    "suffix-name": "<?php\n}\n#[\\self] class EntryIgnoredName {}\n",
    "suffix-parameter": "<?php\n}\nfunction entryIgnoredParameter(void $value) {}\n",
    "suffix-modifiers": "<?php\n}\nabstract final class EntryIgnoredModifiers { abstract final public function ignored(); }\n",
    "suffix-try": "<?php\n}\ntry {}\n",
    "suffix-hook": "<?php\n}\nclass EntryIgnoredHook { public int $value { get() => 1; } }\n",
    "suffix-namespace-layout": "<?php\n}\nnamespace EntryIgnoredNamespace {}\necho 1;\nnamespace EntryIgnoredMixed;\n",
    "suffix-rules": "<?php\n}\nmissing_entry_control(); new EntryIgnoredMissingClass;\n",
    "suffix-recovery": "<?php\n}\nfunction entryIgnoredIncomplete(\n",
    "suffix-tags": "<?php\n} ?>HTML<?php missing_entry_control();\n",
    "valid-balanced": "<?php\n{ class EntryBalanced {} function entryBalanced(): int { return 1; } }\nnew EntryBalanced; entryBalanced();\n",
    "valid-function": "<?php\nfunction entryFunction() { return (object) []; }\nentryFunction();\n",
    "valid-braces-in-comments": "<?php\n/* } */\n// }\n# }\n/** } */\n",
    "valid-inline": "ordinary text }",
    "valid-no-tag": "}",
    "valid-empty": "",
    "valid-tags-only": "<?php "
}
