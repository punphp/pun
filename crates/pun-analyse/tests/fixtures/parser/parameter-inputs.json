{
  "void-function": "function f(void $x) {}",
  "void-case": "function f(VoId $x) {}",
  "void-reference": "function f(void &$x) {}",
  "void-method": "class C { public function f(void $x) {} }",
  "void-interface": "interface C { public function f(void $x); }",
  "void-trait": "trait C { public function f(void $x) {} }",
  "void-closure": "$f = function (void $x) {};",
  "void-arrow": "$f = fn (void $x) => 1;",
  "void-hook": "class C { public int $x { set(void $value) {} } }",
  "void-promoted": "class C { public function __construct(public void $x) {} }",
  "variadic-default": "function f(...$x = 1) {}",
  "variadic-null-default": "function f(int ...$x = null) {}",
  "variadic-reference-default": "function f(int &...$x = []) {}",
  "variadic-closure-default": "$f = function (...$x = []) {};",
  "variadic-arrow-default": "$f = fn (...$x = []) => 1;",
  "variadic-hook-default": "class C { public int $x { set(...$value = []) {} } }",
  "both": "function f(void ...$x = null) {}",
  "multiple-parameters": "function f(void $x, void ...$y = []) {}",
  "both-token-lines": "function f(\n    void\n    ...$x =\n    []\n) {}",
  "parenthesized-default-line": "function f(...$x = (\n    (\n        []\n    )\n)) {}",
  "nested-default": "function f(...$x = new class { public function f(void $x) {} }) {}",
  "member-postchecks": "class C { readonly static public function __construct(void ...$x = []) {} }",
  "attribute-name-precedence": "function f(#[\\self] void $x) {}",
  "earlier-name-precedence": "new \\self;\nfunction f(void $x) {}",
  "default-name-precedence": "function f(...$x = new \\self()) {}",
  "parser-alias-collection": "use Foo as parent;\nfunction f(void $x) {}",
  "positive-untyped": "function f($x) {}",
  "positive-variadic": "function f(int ...$x) {}",
  "positive-ordinary-default": "function f(int $x = 1) {}",
  "positive-reference-variadic": "function f(int &...$x) {}",
  "positive-return-void": "function f(): void {}",
  "positive-scalar-types": "function f(int $a, string $b, bool $c, float $d, array $e, callable $f, object $g, mixed $h, iterable $i) {}",
  "positive-class-types": "class C {} function f(C $a, \\stdClass $b, namespace\\C $c) {}",
  "positive-qualified-void": "function f(\\void $x) {}",
  "positive-relative-void": "function f(namespace\\void $x) {}",
  "positive-nullable-void": "function f(?void $x) {}",
  "positive-union-void": "function f(void|int $x) {}",
  "positive-never": "function f(never $x) {}",
  "positive-named-ordinary-error": "missing_parameter_control();"
}
