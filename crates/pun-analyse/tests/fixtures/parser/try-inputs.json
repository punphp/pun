{
  "bare": "try {}",
  "keyword-line-and-case": "// The diagnostic belongs to the keyword, not either brace.\nTrY\n{\n}",
  "nested": "try {\n    try {}\n}",
  "body-parameter": "try {\n    function bad(void $x) {}\n}",
  "body-member": "try {\n    class C { static function __construct(void $x) {} }\n}",
  "function": "function f() {\n    try {}\n}",
  "closure": "$f = function () {\n    try {}\n};",
  "method": "class C { function f() {\n    try {}\n} }",
  "earlier-name": "#[\\self] class C {}\ntry {}\nmissing_same_file();",
  "body-name": "try {\n    new \\parent;\n}",
  "later-name": "try {}\nnew \\static;",
  "same-file-rules": "try { missing_inside_try(); }\nmissing_after_try();",
  "independent-errors": "try {}\ntry {}",
  "duplicate-errors": "try {} try {}",
  "positive-catch": "try {} catch (\\Throwable $e) {}",
  "positive-finally": "try {} finally {}",
  "positive-both": "try {} catch (\\Throwable) {} finally {}",
  "positive-multiple-catches": "try {} catch (\\RuntimeException|\\LogicException $e) {} catch (\\Throwable) {}",
  "invalid-inside-valid": "try {\n    try {}\n} finally {}",
  "invalid-finally-body": "try {} finally {\n    try {}\n}",
  "catch-body-parameter": "try {} catch (\\Throwable) {\n    function bad(void $x) {}\n}",
  "positive-ordinary-error": "missing_try_parser_control();"
}
