{
  "multiple": "#[\\Deprecated]\nconst A = 1, B = 2;",
  "three-items": "#[\\Deprecated]\nconst A = 1, B = 2, C = 3;",
  "first-attribute-line": "#[\\Deprecated]\n#[\\Deprecated]\nconst\nA = 1,\nB = 2;",
  "earlier-name": "#[\\self] class C {}\n#[\\Deprecated]\nconst A = 1, B = 2;",
  "attribute-name": "#[\\self]\nconst A = 1, B = 2;",
  "value-name": "#[\\Deprecated]\nconst A = new \\parent, B = 2;",
  "same-file-rules": "missing_before_constant();\n#[MissingAttribute]\nconst A = 1, B = 2;\nmissing_after_constant();",
  "positive-single": "#[\\Deprecated]\nconst A = 1;",
  "positive-single-two-attributes": "#[\\Deprecated]\n#[\\Deprecated]\nconst A = 1;",
  "positive-unattributed-multiple": "const A = 1, B = 2;",
  "positive-class-multiple": "class C { #[\\Deprecated] public const A = 1, B = 2; }",
  "positive-class-single": "class C { #[\\Deprecated] public const A = 1; }",
  "positive-ordinary-error": "#[\\Deprecated] const A = 1;\nmissing_constant_attribute_control();"
