{
  "simple": "$value =& new stdClass;",
  "split-start": "$value\n    =\n    &\n    new stdClass;",
  "dynamic-class": "$class = stdClass::class; $value =& new $class;",
  "anonymous-class": "$value =& new class {};",
  "indirect-variable": "$name = 'value'; $$name =& new stdClass;",
  "array-offset": "$values[0] =& new stdClass;",
  "array-append": "$values[] =& new stdClass;",
  "property": "$object->value =& new stdClass;",
  "nullsafe-property": "$object?->value =& new stdClass;",
  "static-property": "class Holder { public static $value; } Holder::$value =& new stdClass;",
  "function-call": "function value() {} value() =& new stdClass;",
  "method-call": "$object->value() =& new stdClass;",
  "nullsafe-method-call": "$object?->value() =& new stdClass;",
  "static-method-call": "class Holder { static function value() {} } Holder::value() =& new stdClass;",
  "function-partial": "function value() {} value(...) =& new stdClass;",
  "method-partial": "$object->value(...) =& new stdClass;",
  "static-method-partial": "class Holder { static function value() {} } Holder::value(...) =& new stdClass;",
  "resolver-suppression": "$value =& new stdClass;\n#[\\self] class InvalidName {}\nmissing_after_reference_new();",
  "ordinary-new": "$value = new stdClass;",
  "ordinary-reference": "$source = 1; $value =& $source;",
  "reference-to-property": "$object = new stdClass; $object->value = 1; $value =& $object->value;",
  "new-property-reference": "$value =& (new stdClass)->value;",
  "unparenthesized-new-property-reference": "$value =& new stdClass()->value;"
}
