{
  "attribute": "#[\\self]\nclass InvalidAttributeName {}",
  "attribute-relative": "namespace N; #[namespace\\PaReNt] class InvalidRelativeAttribute {}",
  "attribute-multiline": "#[\n\\StAtIc\n]\nclass MultilineAttribute {}",
  "attribute-first": "#[\\parent, \\self] class FirstAttribute {} new \\static;",
  "attribute-arguments": "#[Known(new \\parent), \\self] class AttributeArguments {}",
  "attribute-only-argument": "#[Known(new \\parent)] class AttributeArgument {}",
  "attribute-groups": "#[Known(new \\parent)] #[\\self] class AttributeGroups {}",
  "trait-attribute-groups": "#[Known(new \\parent)] #[\\self] trait TraitAttributeGroups {}",
  "interface-attribute-groups": "#[Known(new \\parent)] #[\\self] interface InterfaceAttributeGroups {}",
  "enum-attribute-groups": "#[Known(new \\parent)] #[\\self] enum EnumAttributeGroups {}",
  "enum-case-attribute-groups": "enum EnumCaseAttributeGroups { #[Known(new \\parent)] #[\\self] case A; }",
  "constant-attribute-groups": "#[Known(new \\parent)] #[\\self] const ATTRIBUTE_GROUPS = 1;",
  "function-signature": "#[\\self]\nfunction invalidFunction(#[\\static] \\parent $x): \\self {}",
  "function-return": "function invalidReturn($x = new \\static): \\parent {}",
  "function-second-parameter": "function invalidSecond(int $x, \\self $y) {}",
  "parameter-attributes": "function invalidParameterAttribute(#[\\self] int $x) {}",
  "function-attributes": "#[\\self] function invalidFunctionAttribute(int $x): int { return $x; }",
  "method-signature": "class InvalidMethod { #[\\static] function f(\\parent $x): \\self {} }",
  "closure-signature": "$f = #[\\static] function(\\parent $x): \\self {};",
  "arrow-signature": "$f = #[\\static] fn(\\parent $x): \\self => $x;",
  "nullable": "function invalidNullable(?\\self $x) {}",
  "union": "function invalidUnion(int|\\parent $x) {}",
  "intersection": "function invalidIntersection(Countable&\\static $x) {}",
  "dnf": "function invalidDnf((Countable&\\static)|null $x) {}",
  "plain-property": "class InvalidProperty { #[\\self] public \\parent $x; }",
  "hooked-property": "class InvalidHookedProperty { #[\\self] public \\parent $x { get => $this->x; } }",
  "hook-signature": "class InvalidHook { public int $x { #[\\self] set(\\parent $value) {} } }",
  "hook-attribute": "class InvalidHookAttribute { public int $x { #[\\parent] get => 1; } }",
  "class-constant": "class InvalidConstant { #[\\self] public const \\parent X = 1; }",
  "global-constant": "#[\\self] const INVALID_GLOBAL = 1;",
  "enum-attribute": "#[\\self] enum InvalidEnumAttribute {}",
  "enum-case": "enum InvalidEnumCase { #[\\self] case A; }",
  "trait-attribute": "#[\\self] trait InvalidTraitAttribute {}",
  "interface-attribute": "#[\\self] interface InvalidInterfaceAttribute {}",
  "anonymous-attribute": "$x = new #[\\self] class(new \\parent) {};",
  "anonymous-attribute-argument": "$x = new #[Known(new \\parent)] class {};",
  "anonymous-body-before-arguments": "$x = new class(new \\self) { function f(\\parent $x) {} };",
  "trait-use": "class InvalidTraitUse { use \\self; }",
  "trait-alias": "class InvalidTraitAlias { use SomeTrait { \\self::f as g; } }",
  "trait-precedence": "class InvalidTraitPrecedence { use SomeTrait { SomeTrait::f insteadof \\self; } }",
  "trait-precedence-receiver": "class InvalidTraitReceiver { use SomeTrait { \\parent::f insteadof \\self; } }",
  "instantiation": "new \\parent;",
  "instantiation-relative": "namespace Relative; new namespace\\self;",
  "instanceof": "$x instanceof \\static;",
  "instanceof-order": "(new \\self) instanceof \\parent;",
  "static-method": "\\parent::f();",
  "static-callable": "\\self::f(...);",
  "static-property": "\\static::$x;",
  "class-constant-fetch": "\\self::X;",
  "class-name-fetch": "\\parent::class;",
  "catch": "try {} catch (\\static $e) {}",
  "catch-union": "try {} catch (Exception|\\self $e) {}",
  "unreachable": "if (false) { new \\self; }",
  "same-file-suppression": "missing_before();\n#[\\self] // @phpstan-ignore phpstan.parse\nclass InvalidSuppressed {}\nmissing_after();\n// @phpstan-ignore\nmissing_last();",
  "class-reserved": "class self {}",
  "class-parent-reserved": "class parent {}",
  "class-static-grammar": "class static {}",
  "extends-reserved": "#[\\self] class InvalidExtends extends \\parent {}",
  "implements-reserved": "class InvalidImplements implements namespace\\static {}",
  "interface-reserved": "interface self {}",
  "interface-extends": "interface InvalidInterface extends \\self {}",
  "enum-reserved": "enum parent {}",
  "enum-implements": "enum InvalidEnum implements \\static {}",
  "anonymous-extends": "$x = new class extends \\self {};",
  "anonymous-implements": "$x = new class implements \\parent {};",
  "reserved-collect": "class self {}\nuse Foo as parent;\n#[\\static] class IgnoredResolver {}",
  "reserved-alias": "use Foo as self;",
  "reserved-static-alias-grammar": "use Foo as static;",
  "reserved-alias-line": "use Root\\Foo as\n    PaReNt;",
  "reserved-function-alias": "use function Foo as parent;",
  "reserved-constant-alias": "use const Foo as self;",
  "reserved-group-alias": "use Root\\{Foo as parent};",
  "duplicate-class": "use Foo as X;\nuse Bar as x;",
  "duplicate-function": "use function Foo as X; use function Bar as x;",
  "duplicate-constant": "use const Foo as X; use const Bar as X;",
  "duplicate-group": "use Foo as X; use Root\\{Bar as x};",
  "duplicate-typed-group": "use function Root\\{Foo as X, Bar as x};",
  "duplicate-mixed-group": "use Root\\{function Foo as X, const A, function Bar as x};",
  "duplicate-implicit": "use Root\\Foo; use Other\\Foo;",
  "duplicate-multiple": "use A as X, B as x; new \\parent;",
  "alias-parser-precedence": "use A as X; use B as x; use C as self;",
  "positive-role-controls": "#[self, Foo\\self, \\Foo\\self, self\\Foo] class PositiveAttribute {}\n\\self(); namespace\\static(); echo \\static;",
  "positive-alias-target": "use \\self as ImportedSpecial; #[ImportedSpecial] class PositiveAlias {}",
  "positive-namespace-reset": "namespace First { use Foo as X; } namespace Second { use Bar as X; }",
  "positive-constant-case": "use const PHP_VERSION as V; use const PHP_VERSION_ID as v; echo V; echo v;",
  "positive-import-kinds": "use Exception as X; use function strlen as X; use const PHP_VERSION as X;",
  "positive-special-types": "class PositiveTypes { function f(self $x): self { return $x; } }",
  "positive-enum-type-role": "enum PositiveEnumType: \\self {}",
  "positive-trait-special": "namespace PositiveTrait; trait self {}",
  "positive-anonymous-body": "$x = new class { function f(): int { return 1; } };",
  "positive-namespace": "namespace self; class PositiveNamespace {}",
  "positive-ordinary": "missing_control();",
  "positive-callable": "$f = new stdClass(...);"
}
